# SQLite in development. For PostgreSQL: set provider = "postgresql" in prisma/schema.prisma and use a postgres:// URL.
DATABASE_URL="file:./dev.db"

# Optional — enables real image analysis with Claude. Without it PARTART uses editable category templates.
ANTHROPIC_API_KEY=
# Optional override. PARTART deliberately ignores ANTHROPIC_BASE_URL so a shell-level proxy setting is not picked up by accident.
PARTART_ANTHROPIC_BASE_URL=

# Where generated files are stored (default ./storage)
PARTART_STORAGE_DIR=
